# ==========================================================================
# CONFIGURACIÓN DE BASE DE DATOS EN LA NUBE (RAILWAY + VERCEL)
# ==========================================================================

# 1. Opción recomendada para Vercel: Copiar la URL completa de MySQL en Railway
MYSQL_URL=mysql://root:PASSWORD@HOST:PORT/railway

# 2. Opción por variables individuales de Railway:
MYSQLHOST=containers-us-west-xxx.railway.app
MYSQLUSER=root
MYSQLPASSWORD=tu_password_aqui
MYSQLDATABASE=railway
MYSQLPORT=3306

PORT=3000
